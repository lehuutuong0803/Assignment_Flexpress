# Optional overrides for docker-compose.yml. Copy to .env only if you want different values;
# `docker compose up` works without a .env file (dev-only defaults are built in).
# Placeholders only. Real secrets never go in git; in production they come from CI variables.

# PostgreSQL
DB_NAME=delivery
DB_USER=delivery
DB_PASSWORD=change-me

# Keycloak bootstrap admin (http://localhost:8080/admin)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me

# S3-compatible storage (MinIO locally)
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-at-least-8-chars
S3_BUCKET=flexpress-pod

# delivery-service
# Host port of the API (stop `npm run start:dev` first, or pick another port).
APP_PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
