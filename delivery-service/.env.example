# For running the service on the host (`npm run start:dev`) against the docker compose stack.
# Copy to .env (gitignored). Values match the dev-only defaults in docker-compose.yml.
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=delivery
DB_USER=delivery
DB_PASSWORD=dev-only-db-password
DB_SSL=false

# Issuer as it appears in tokens; JWKS fetched from the same host when running outside Docker.
KEYCLOAK_ISSUER=http://localhost:8080/realms/flexpress
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/flexpress/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=delivery-service
