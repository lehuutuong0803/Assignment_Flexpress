{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "/node_modules/jose/.+\\.js$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true,
          "module": "commonjs",
          "moduleResolution": "node10"
        },
        "diagnostics": false
      }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!jose/)"
  ]
}
